# Dữ liệu thô / đã xử lý (không commit dataset lớn).
# Ngoại lệ: data/custom_suite là bộ test tự viết (nhỏ, ~10 KB) — commit để code
# test nằm trong repo; `data/*` (không phải `data/`) + `!` mới re-include được.
data/*
!data/custom_suite/
!data/custom_suite_java/
!data/processed/coder_benchmark/

# Kết quả chạy (giữ reports/ và bảng metrics json, bỏ checkpoints nặng)
results/*/checkpoints/
*.pt
*.bin
*.onnx

# Môi trường
.venv/
__pycache__/
*.pyc
.env
tasks/.env

# HuggingFace / torch cache
.cache/
.pytest_cache/
.ruff_cache/
tmp/
.agents/

# Cache AST sinh lại được
artifacts/
!artifacts/ast_cache/t4_calibration.json

# Build LaTeX
reports/*.aux
reports/*.log
reports/*.out
reports/*.lot
reports/*.lof
reports/*.gz
reports/figures/*.aux
reports/figures/*.log

*.zip
workspace/
warm_start/
kaggle_tmp/
kaggle_output/
hs_*.log
*.log
