# Copy file này thành `tasks/.env` rồi điền. KHÔNG commit file .env.

# 1) Internal Integration Secret — lấy ở https://www.notion.so/my-integrations
#    (New integration -> chọn workspace -> copy "Internal Integration Secret")
NOTION_TOKEN=

# 2) Trang "Project Manager" (mặc định lấy từ URL bạn đã gửi). Script tự dò database con trong trang.
NOTION_PAGE_ID=

# 2b) Hoặc chỉ định thẳng database (nếu muốn). Có cái này thì bỏ qua bước dò trang.
# NOTION_DATABASE_ID=

# 2c) Database "projects" (tham chiếu).
# NOTION_PROJECTS_DATABASE_ID=

# 2d) Tên project — script tự tìm id trong db projects để gắn vào cột relation.
# NOTION_PROJECT_NAME=
# NOTION_PROJECT_PROP=Project

# 3) Tên property — để trống thì script tự dò theo kiểu dữ liệu (chạy --schema để xem).
# NOTION_TITLE_PROP=Name
# NOTION_DATE_PROP=Date
# NOTION_STATUS_PROP=Status
# NOTION_NOTES_PROP=Notes

# 4) (tuỳ chọn) phiên bản API
# NOTION_VERSION=2022-06-28
